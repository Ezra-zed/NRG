# Server
PORT=5000
NODE_ENV=development

# MongoDB — MongoDB Atlas SRV connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Cloudinary — project request bill uploads
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
# Access JWTs expire after 15 minutes. Refresh sessions last 30 days and rotate
# on every successful /api/refresh.
# The OTP stub is disabled unless explicitly enabled in local development.
# ENABLE_DEV_OTP_STUB=true

# Google OAuth authorization-code flow
OAUTH_CLIENT_ID=your_google_client_id
OAUTH_CLIENT_SECRET=your_google_client_secret
# REQUIRED in production: must exactly match a URI registered in Google Cloud Console.
# Local default: http://localhost:5000/auth/google/callback (fixed port, ignores PORT)
OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Frontend redirect settings (adjust to your local frontend port)
FRONTEND_PORT=3000
LOCAL_FRONTEND_URL=http://localhost:3000
PRODUCTION_FRONTEND_URL=https://your-deployed-frontend.example.com

# Company AI assistant
AI_API_KEY=replace_with_your_ai_provider_key
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_RATE_LIMIT_MAX=10